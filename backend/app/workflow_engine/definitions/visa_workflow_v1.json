{
  "name": "visa_workflow",
  "version": "v1",
  "description": "Corporate visa application with document verification and tracking",
  "sla_hours": 72,
  "steps": [
    {
      "name": "validation",
      "agent": "ValidationAgent",
      "description": "Validate employee identity, passport validity, and travel eligibility",
      "retry_limit": 2,
      "on_failure": "escalate",
      "timeout_seconds": 30,
      "human_approval": false
    },
    {
      "name": "document_verification",
      "agent": "DocumentAgent",
      "description": "Verify all required documents for visa application",
      "retry_limit": 2,
      "on_failure": "escalate",
      "timeout_seconds": 45,
      "human_approval": false
    },
    {
      "name": "policy_check",
      "agent": "PolicyAgent",
      "description": "Check visa policy for destination country",
      "retry_limit": 1,
      "on_failure": "abort",
      "timeout_seconds": 30,
      "human_approval": false
    },
    {
      "name": "visa_processing",
      "agent": "VisaAgent",
      "description": "Process visa application and submit to embassy",
      "retry_limit": 2,
      "on_failure": "escalate",
      "timeout_seconds": 60,
      "human_approval": false
    },
    {
      "name": "manager_approval",
      "agent": "ApprovalAgent",
      "description": "Manager authorization for international travel",
      "retry_limit": 1,
      "on_failure": "escalate",
      "timeout_seconds": null,
      "human_approval": true,
      "approval_level": 1,
      "approval_role": "manager",
      "timeout_hours": 48
    },
    {
      "name": "finance_processing",
      "agent": "FinanceAgent",
      "description": "Process visa fees and create expense invoice",
      "retry_limit": 2,
      "on_failure": "escalate",
      "timeout_seconds": 30,
      "human_approval": false
    },
    {
      "name": "notification",
      "agent": "NotificationAgent",
      "description": "Notify employee of visa application status",
      "retry_limit": 3,
      "on_failure": "log",
      "timeout_seconds": 15,
      "human_approval": false
    },
    {
      "name": "audit",
      "agent": "AuditAgent",
      "description": "Audit trail for visa processing",
      "retry_limit": 1,
      "on_failure": "log",
      "timeout_seconds": 10,
      "human_approval": false
    }
  ]
}
