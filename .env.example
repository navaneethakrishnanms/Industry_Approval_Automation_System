# ─────────────────────────────────────────────
# AI Workforce OS — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# App
APP_NAME="AI Workforce OS"
APP_VERSION="1.0.0"
APP_ENV="development"        # development | staging | production
DEBUG=true
SECRET_KEY="change-me-in-production-use-32-char-random-string"

# Database
DATABASE_URL="sqlite+aiosqlite:///./ai_workforce.db"
# For PostgreSQL: DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/ai_workforce"

# JWT Auth
JWT_SECRET_KEY="change-me-in-production-jwt-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / LLM
GEMINI_API_KEY=""            # Leave empty to use mock LLM (demo-safe)
GEMINI_MODEL="gemini-1.5-flash"
USE_MOCK_LLM=true            # Set false if GEMINI_API_KEY is provided

# External Integrations
AVIATIONSTACK_API_KEY=""     # Leave empty for synthetic flight data
DEMO_MODE=true               # true = synthetic data, false = live APIs

# ChromaDB (Policy RAG)
CHROMA_PERSIST_DIR="./chroma_db"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Logging
LOG_LEVEL="INFO"

# Demo Tenants (pre-seeded)
DEMO_TENANT_1="GlobalTech Corp"
DEMO_TENANT_2="Acme Industries"
